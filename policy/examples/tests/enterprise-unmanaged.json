{
  "policy": "../enterprise.json",
  "device": { "mdm-enrolled": "fail" },
  "cases": [
    {
      "name": "an unmanaged device is denied the shell",
      "call": { "tool": "Shell", "toolset": "shell", "annotations": { "destructive": true } },
      "expect": { "severity": "deny", "failed_signals": ["mdm-enrolled"], "rules": ["managed-device"] }
    },
    {
      "name": "the managed-device rule covers even a snapshot",
      "call": { "tool": "Snapshot", "toolset": "screen", "annotations": { "read_only": true } },
      "expect": { "severity": "deny", "failed_signals": ["mdm-enrolled"], "rules": ["managed-device"] }
    }
  ]
}
